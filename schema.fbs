struct Rect {
    x: float;
    y: float;
    width: float;
    height: float;
}

table DomNode {
    id: uint32;
    tag: string;
    has_text: bool;
    text: string;
    rect: Rect;
}

table Metadata {
    timestamp: uint64;
    width: uint32;
    height: uint32;
    nodes: [DomNode];
}

root_type Metadata;