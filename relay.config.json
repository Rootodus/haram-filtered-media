{
    "projectId": "mlfb-av-core",
    "root": "./",
    "include": [
        "mlfb-av-core/src/**/*.rs",
        "mlfb-av-core/examples/**/*.rs",
        "full-version/src/**/*.rs"
    ],
    "exclude": ["**/target/**", "**/.relay/**", "**/.aider.tags.cache.v4/**"],
    "core": {
        "logLevel": "info",
        "enableNotifications": true,
        "watchConfig": true
    },
    "watcher": {
        "clipboardPollInterval": 2000,
        "preferredStrategy": "auto",
        "enableBulkProcessing": false,
        "bulkSize": 5,
        "bulkTimeout": 30000
    },
    "patch": {
        "approvalMode": "auto",
        "approvalOnErrorCount": 999999,
        "linter": "",
        "preCommand": "",
        "postCommand": "",
        "minFileChanges": 0
    },
    "git": {
        "autoGitBranch": false,
        "gitBranchPrefix": "relay/",
        "gitBranchTemplate": "gitCommitMsg"
    }
}
