{
    "projectId": "mlfb-av-core",
    "core": {
        "logLevel": "info",
        "enableNotifications": true,
        "watchConfig": true
    },
    "watcher": {
        "clipboardPollInterval": 2000,
        "preferredStrategy": "auto",
        "enableBulkProcessing": false,
        "bulkSize": 5,
        "bulkTimeout": 30000
    },
    "patch": {
        "approvalMode": "auto",
        "approvalOnErrorCount": 0,
        "linter": "cargo check --all-targets",
        "preCommand": "",
        "postCommand": "",
        "minFileChanges": 0
    },
    "git": {
        "autoGitBranch": false,
        "gitBranchPrefix": "relay/",
        "gitBranchTemplate": "gitCommitMsg"
    }
}
